# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Native/local build trees
**/build/
# ...except tools/xbox360/build/, which is the tracked reproducible build
# recipe and pin ledger (README.md, pins.json, verify_pins.py), not a build tree.
!tools/xbox360/build/
!tools/xbox360/build/**
*.o
*.obj
*.a
*.lib
*.so
*.dylib

# Local runtime captures and large binary traces
*.trace
*.trace.gz
*.trace.zst
SHIFT_tail_*.trace
single_frame.trace

# Local capture output
captures/
capture/
artifacts/

# Xbox 360 retail and generated game output — DO NOT COMMIT
*.xex
*.iso
*.000
*.stfs
xbox360/game/
xbox360/retail/
xbox360/dumps/
xbox360/generated/
xbox360/out/
xbox360/sdk-build/
